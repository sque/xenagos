{
  "$defs": {
    "AgentRequest": {
      "additionalProperties": false,
      "description": "A fixed request the reviewer sends with a control in the viewer.",
      "properties": {
        "kind": {
          "enum": [
            "walkthrough",
            "narration",
            "visual"
          ],
          "type": "string"
        },
        "visual": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The visual to repair, for `visual`."
        }
      },
      "required": [
        "kind"
      ],
      "title": "AgentRequest",
      "type": "object"
    },
    "AgentStatus": {
      "additionalProperties": false,
      "description": "The review's agent session as the viewer shows it (spec: agent-link).\n\n`state` is `none` (no session yet), `attachable` (a running background session the pane can show), `not-shown`\n(a session of a kind the pane cannot show), `ended` (stopped or gone), or `unavailable` (Claude Code could not be\nasked).",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What Claude Code reports while it runs: idle, busy, ..."
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the pane is empty, for the reviewer."
        },
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shared": {
          "default": false,
          "description": "The session is also shown in another terminal.",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "none",
            "attachable",
            "not-shown",
            "ended",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "AgentStatus",
      "type": "object"
    },
    "CategoryCoverage": {
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "integer"
        },
        "category": {
          "enum": [
            "code",
            "tests",
            "generated"
          ],
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/UncoveredFile"
          },
          "type": "array"
        },
        "removed": {
          "type": "integer"
        }
      },
      "required": [
        "category",
        "files",
        "added",
        "removed"
      ],
      "title": "CategoryCoverage",
      "type": "object"
    },
    "ChangedFile": {
      "additionalProperties": false,
      "description": "A file the change touches, as the diff of the pinned revisions has it.",
      "properties": {
        "binary": {
          "type": "boolean"
        },
        "hunks": {
          "items": {
            "$ref": "#/$defs/HunkInfo"
          },
          "type": "array"
        },
        "oldPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "description": "Head path, or base path for a deleted file.",
          "type": "string"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied",
            "type-changed"
          ],
          "type": "string"
        }
      },
      "required": [
        "path",
        "oldPath",
        "status",
        "binary",
        "hunks"
      ],
      "title": "ChangedFile",
      "type": "object"
    },
    "CodeSelection": {
      "additionalProperties": false,
      "description": "Lines the reviewer selected. In the unified view a selection can start on a deleted line and end on an added\none, so each end names its side.",
      "properties": {
        "endLine": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "endSide": {
          "enum": [
            "base",
            "head"
          ],
          "type": "string"
        },
        "kind": {
          "const": "code",
          "type": "string"
        },
        "path": {
          "description": "The file as the viewer names it: its head path, or base path if deleted.",
          "type": "string"
        },
        "startLine": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "startSide": {
          "enum": [
            "base",
            "head"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "startSide",
        "startLine",
        "endSide",
        "endLine"
      ],
      "title": "CodeSelection",
      "type": "object"
    },
    "CodeTarget": {
      "additionalProperties": false,
      "description": "Lines of a file at the base or head revision, optionally narrowed to a span of characters.\n\nLines and columns count from 1 and both ends are included. With a span, `startCol` is on the first line and\n`endCol` on the last.",
      "properties": {
        "endCol": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "endLine": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "expect": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text that must occur in the targeted range; catches a valid range that points at the wrong code."
        },
        "path": {
          "type": "string"
        },
        "side": {
          "default": "head",
          "enum": [
            "base",
            "head"
          ],
          "type": "string"
        },
        "startCol": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "startLine": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "startLine",
        "endLine"
      ],
      "title": "CodeTarget",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "What the plan leaves out, by category in the order Code, Tests, Generated; empty categories are omitted.",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/CategoryCoverage"
          },
          "type": "array"
        },
        "files": {
          "description": "How many files have a hunk no section claims.",
          "type": "integer"
        },
        "hunks": {
          "description": "How many hunks no section claims.",
          "type": "integer"
        }
      },
      "required": [
        "categories",
        "hunks",
        "files"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Delivery": {
      "additionalProperties": false,
      "description": "What happened to a question or request.",
      "properties": {
        "session": {
          "type": "string"
        },
        "started": {
          "description": "True when a session was started for it, with it as the first message.",
          "type": "boolean"
        }
      },
      "required": [
        "started",
        "session"
      ],
      "title": "Delivery",
      "type": "object"
    },
    "ElementSelection": {
      "additionalProperties": false,
      "properties": {
        "element": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "kind": {
          "const": "element",
          "type": "string"
        },
        "visual": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "visual",
        "element"
      ],
      "title": "ElementSelection",
      "type": "object"
    },
    "FileView": {
      "additionalProperties": false,
      "description": "A file at both pinned revisions, for the whole-file view. Text is absent when the file does not exist at that\nrevision or is binary.",
      "properties": {
        "base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "binary": {
          "type": "boolean"
        },
        "head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "oldPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied",
            "type-changed",
            "unchanged"
          ],
          "type": "string"
        }
      },
      "required": [
        "path",
        "oldPath",
        "status",
        "binary",
        "base",
        "head"
      ],
      "title": "FileView",
      "type": "object"
    },
    "HunkInfo": {
      "additionalProperties": false,
      "properties": {
        "baseCount": {
          "type": "integer"
        },
        "baseStart": {
          "type": "integer"
        },
        "headCount": {
          "type": "integer"
        },
        "headStart": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "baseStart",
        "baseCount",
        "headStart",
        "headCount"
      ],
      "title": "HunkInfo",
      "type": "object"
    },
    "Orientation": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The document the problem is taken from."
        },
        "problem": {
          "description": "The problem the change addresses, before any solution; a short paragraph.",
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "enum": [
            "commit-messages",
            "document",
            "inferred"
          ],
          "type": "string"
        }
      },
      "required": [
        "problem",
        "source"
      ],
      "title": "Orientation",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "$ref": "#/$defs/Orientation"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "minItems": 1,
          "type": "array"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/StyleRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by xenagos when it accepts the plan: the style its narration was checked against."
        }
      },
      "required": [
        "orientation",
        "sections"
      ],
      "title": "Plan",
      "type": "object"
    },
    "PlanRejection": {
      "additionalProperties": false,
      "description": "Why a submitted plan was not accepted; each problem names the plan item it concerns.",
      "properties": {
        "problems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "problems"
      ],
      "title": "PlanRejection",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "Where the reviewer was in the walkthrough, counted from 1.",
      "properties": {
        "section": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "step": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "section",
        "step"
      ],
      "title": "Position",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "question": {
          "maxLength": 4000,
          "type": "string"
        },
        "selection": {
          "discriminator": {
            "mapping": {
              "code": "#/$defs/CodeSelection",
              "element": "#/$defs/ElementSelection"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CodeSelection"
            },
            {
              "$ref": "#/$defs/ElementSelection"
            }
          ]
        }
      },
      "required": [
        "question",
        "selection"
      ],
      "title": "Question",
      "type": "object"
    },
    "ReviewInfo": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "style": {
          "description": "The active narration style: a walkthrough asked for now is written in it.",
          "type": "string"
        },
        "voice": {
          "$ref": "#/$defs/VoiceInfo"
        }
      },
      "required": [
        "id",
        "repo",
        "label",
        "base",
        "head",
        "branch",
        "style",
        "voice"
      ],
      "title": "ReviewInfo",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "minLength": 1,
          "type": "string"
        },
        "hunks": {
          "description": "The hunks that implement this section's idea.",
          "items": {
            "pattern": "^[^\\s].*:h[1-9][0-9]*$",
            "type": "string"
          },
          "type": "array"
        },
        "role": {
          "enum": [
            "core",
            "consequence",
            "support"
          ],
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "description": "Names the section's idea, not a file.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "visuals": {
          "items": {
            "$ref": "#/$defs/Visual"
          },
          "type": "array"
        }
      },
      "required": [
        "title",
        "role",
        "explanation",
        "hunks",
        "steps"
      ],
      "title": "Section",
      "type": "object"
    },
    "SessionChoiceItem": {
      "additionalProperties": false,
      "description": "A Claude Code session the reviewer can make the review's agent.",
      "properties": {
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "running": {
          "type": "boolean"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session",
        "name",
        "kind",
        "running",
        "cwd"
      ],
      "title": "SessionChoiceItem",
      "type": "object"
    },
    "Show": {
      "additionalProperties": false,
      "description": "Something the agent points at in the viewer.",
      "properties": {
        "form": {
          "default": "lines",
          "enum": [
            "lines",
            "box",
            "circle"
          ],
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeTarget"
            },
            {
              "$ref": "#/$defs/VisualTarget"
            }
          ]
        }
      },
      "required": [
        "target"
      ],
      "title": "Show",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "form": {
          "enum": [
            "lines",
            "box",
            "circle"
          ],
          "type": "string"
        },
        "narration": {
          "description": "Plain text, spoken as written and shown as the caption.",
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeTarget"
            },
            {
              "$ref": "#/$defs/VisualTarget"
            }
          ]
        }
      },
      "required": [
        "narration",
        "form",
        "target"
      ],
      "title": "Step",
      "type": "object"
    },
    "StyleRef": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "hash"
      ],
      "title": "StyleRef",
      "type": "object"
    },
    "UncoveredFile": {
      "additionalProperties": false,
      "description": "A changed file with hunks that no section of the plan claims (spec: walkthrough-plan, \"Coverage is visible\").",
      "properties": {
        "added": {
          "description": "Lines added by the hunks listed.",
          "type": "integer"
        },
        "binary": {
          "type": "boolean"
        },
        "category": {
          "enum": [
            "code",
            "tests",
            "generated"
          ],
          "type": "string"
        },
        "hunks": {
          "description": "The hunks no section claims.",
          "items": {
            "$ref": "#/$defs/HunkInfo"
          },
          "type": "array"
        },
        "oldPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "partly": {
          "description": "Some of the file's hunks are claimed by a section, the ones listed are not.",
          "type": "boolean"
        },
        "path": {
          "description": "Head path, or base path for a deleted file.",
          "type": "string"
        },
        "removed": {
          "description": "Lines removed by the hunks listed.",
          "type": "integer"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed",
            "copied",
            "type-changed"
          ],
          "type": "string"
        }
      },
      "required": [
        "path",
        "oldPath",
        "status",
        "binary",
        "category",
        "partly",
        "hunks",
        "added",
        "removed"
      ],
      "title": "UncoveredFile",
      "type": "object"
    },
    "Visual": {
      "additionalProperties": false,
      "description": "Agent-authored HTML shown in a sandboxed frame (spec: section-visuals).",
      "properties": {
        "elements": {
          "description": "Every element that can be linked, selected or spotlighted.",
          "items": {
            "$ref": "#/$defs/VisualElement"
          },
          "type": "array"
        },
        "html": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "html"
      ],
      "title": "Visual",
      "type": "object"
    },
    "VisualElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "link": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Code shown when the reviewer activates the element."
        }
      },
      "required": [
        "id"
      ],
      "title": "VisualElement",
      "type": "object"
    },
    "VisualTarget": {
      "additionalProperties": false,
      "description": "An element that one of the section's visuals declares.",
      "properties": {
        "element": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        "visual": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "visual",
        "element"
      ],
      "title": "VisualTarget",
      "type": "object"
    },
    "VoiceInfo": {
      "additionalProperties": false,
      "description": "Voice settings from configuration (spec: configuration).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "enum": [
            "browser",
            "command"
          ],
          "type": "string"
        },
        "speed": {
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "provider",
        "name",
        "speed"
      ],
      "title": "VoiceInfo",
      "type": "object"
    }
  },
  "title": "xenagos"
}
